NODE_ENV=production
APP_ORIGIN=https://harshitrv.in
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD_HASH=replace-with-pnpm-admin-hash-output
SESSION_SECRET=replace-with-at-least-32-random-characters
PROJECT_DATA_FILE=/var/lib/harshitrv-portfolio/projects.json
PROJECT_BACKUP_DIR=/var/lib/harshitrv-portfolio/backups
# Set to true only when the Node port is reachable exclusively through a trusted proxy.
TRUST_PROXY=false
NITRO_HOST=127.0.0.1
NITRO_PORT=3000
